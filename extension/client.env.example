# .env (local, gitignored) – machine-specific values
OMP_GIT_URL=git@github.com:your-user/your-repo.git
# OMP_SHELL_PATH=C:\Program Files\PowerShell\7\pwsh.exe

# .env.synced (synced via git) – shared values for all machines
# SEARXNG_ENDPOINT=https://your-searxng.example.com/
# BRAVE_API_KEY=your-key
# NTFY_SERVER=https://your-ntfy.example.com
# NTFY_TOPIC=your-topic
# NTFY_VERBOSITY=normal
